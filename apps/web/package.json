{
  "name": "web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "rm -rf .next && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "cms:bootstrap": "node ../../tools/didm-cms/bootstrap-mongodb-admin.mjs",
    "cms:migrate:dry-run": "node ../../tools/didm-cms/migrate-sqlite-to-mongodb.mjs",
    "test:migration": "node --test ../../tools/didm-cms/migration-core.test.mjs",
    "cms:atlas:verify": "node ../../tools/didm-cms/verify-atlas-connections.mjs",
    "cms:atlas:verify-development": "node ../../tools/didm-cms/verify-atlas-connections.mjs --development-only",
    "cms:test:prepare": "node ../../tools/didm-cms/prepare-test-database.mjs"
